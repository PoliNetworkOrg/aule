{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "oxc"],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    "@shadcn/lint"
  ],
  "ignorePatterns": ["dist/**", "tools/oxlint/anti-slop/**", "src/routeTree.gen.ts"],
  "rules": {
    "oxc/no-accumulating-spread": "error",
    "anti-slop/no-array-filter-map": "error",
    "anti-slop/no-reduce-accumulator-copy": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": [
      "error",
      {
        "allowInTypeGuards": true
      }
    ],
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-readable-spacing": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error",
    "shadcn/no-unknown-classes": [
      "error",
      {
        "allow": [
          "hgi-*",
          "liquid-glass",
          "empty",
          "secondary",
          "splash-header-item",
          "changelog-container",
          "splash-loading-label",
          "visible",
          "settings-toggle__thumb",
          "pill-active-cell",
          "dcp-popup__title-text",
          "trc-trigger__value-from",
          "trc-trigger__value-to",
          "tp-switch__label",
          "tp-step-minus",
          "tp-step-plus",
          "tp-popup__quick",
          "tp-quick-now",
          "tp-text-node",
          "tp-quick-preset",
          "tp-quick-label",
          "trs-title-text",
          "trs-badge--from",
          "trs-badge--to",
          "campus-option",
          "campus-option__area",
          "campus-option__check",
          "campus-option__name",
          "campus-option__text",
          "campus-select",
          "campus-select-skeleton",
          "campus-select__box",
          "campus-select__chevron",
          "campus-select__icon",
          "campus-select__label",
          "campus-select__value",
          "cp-native",
          "cp-opt-",
          "cp-overlay",
          "cp-panel-host",
          "cp-popup",
          "cp-popup__inner",
          "cp-popup__title",
          "cp-popup__title-icon",
          "cp-popup__title-text",
          "cp-section",
          "cp-section-label",
          "star-icon--filled",
          "classroom-card--plain",
          "data-status-description",
          "data-status-time",
          "data-reload-label",
          "bo-count-label",
          "info-intro",
          "info-section-text"
        ]
      }
    ],
    "shadcn/no-raw-colors": "error"
  }
}
